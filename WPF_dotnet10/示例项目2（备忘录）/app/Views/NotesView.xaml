<UserControl x:Class="MemoTask.Views.NotesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:StartUI4Controls;assembly=StartUI4Controls"
             xmlns:h="clr-namespace:MemoTask.Helpers">
    <!-- 间距刻度：4 的倍数。分组之间 16，同排兄弟 12，内容到窗口边缘 20。
         卡片外边距 24 ≥ ShadowDepth(12) + ShadowBlurRadius(12) 的余量需求，投影四边不被切。 -->
    <Grid Margin="20,20,20,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ui:UI4Button Grid.Column="0" Content="＋ 新建备忘" Height="36" Width="112"
                          Command="{Binding NewNoteCommand}"/>

            <ui:UI4TextBox x:Name="SearchBox" Grid.Column="1" Height="36" Margin="12,0,12,0"
                           PlaceholderText="搜索标题、正文或标签…"
                           ShowClearButton="True"
                           Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>

            <ui:UI4ComboBox Grid.Column="2" MinWidth="144" Height="36" Margin="0,0,12,0"
                            HorizontalAlignment="Left"
                            ItemsSource="{Binding TagOptions}" DisplayMemberPath="Label"
                            SelectedValuePath="Key" SelectedValue="{Binding TagFilter, Mode=TwoWay}"/>

            <ui:UI4ComboBox Grid.Column="3" MinWidth="160" Height="36"
                            HorizontalAlignment="Left"
                            ItemsSource="{Binding SortOptions}" DisplayMemberPath="Label"
                            SelectedValuePath="Key" SelectedValue="{Binding SortKey, Mode=TwoWay}"/>
        </Grid>

        <Grid Grid.Row="1" Margin="0,16,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding SummaryText}" FontSize="12"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource UI4.Brush.TextMuted}"/>
            <TextBlock Grid.Column="1" Text="{Binding SaveStatus}" FontSize="12"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource UI4.Brush.Icon}"/>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding ListColumnWidth}"/>
                <ColumnDefinition Width="{Binding GapColumnWidth}"/>
                <ColumnDefinition Width="{Binding DetailColumnWidth}"/>
            </Grid.ColumnDefinitions>

            <!-- 列表档 -->
            <Grid Grid.Column="0" Visibility="{Binding ShowList, Converter={StaticResource BoolToVis}}">
                <ui:UI4ListView x:Name="NoteList"
                                ItemsSource="{Binding Cards}"
                                SelectedItem="{Binding SelectedCard, Mode=TwoWay}"
                                IsSynchronizedWithCurrentItem="False"
                                ItemMargin="24" ItemCornerRadius="12"
                                ShadowDepth="12" ShadowBlurRadius="12" ShadowOpacity="0.16"
                                HoverScale="1"
                                Background="Transparent">
                    <ui:UI4ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="20,16,20,16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Orientation="Horizontal">
                                    <Border Background="{DynamicResource UI4.Brush.Accent}"
                                            CornerRadius="4" Padding="8,4,8,4" Margin="0,0,8,0"
                                            Visibility="{Binding Pinned, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="置顶" FontSize="11"
                                                   Foreground="{DynamicResource UI4.Brush.OnAccent}"/>
                                    </Border>
                                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" MaxWidth="360"
                                               Foreground="{DynamicResource UI4.Brush.Text}"/>
                                </StackPanel>

                                <TextBlock Grid.Row="1" Margin="0,8,0,0" Text="{Binding Preview}"
                                           FontSize="13" TextWrapping="Wrap" MaxHeight="44"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource UI4.Brush.TextMuted}"/>

                                <StackPanel Grid.Row="2" Margin="0,8,0,0">
                                    <TextBlock Text="{Binding MetaLine}" FontSize="12"
                                               Foreground="{DynamicResource UI4.Brush.Icon}"/>
                                    <TextBlock Margin="0,4,0,0" FontSize="12"
                                               Text="{Binding TagsLabel, StringFormat=＃ {0}}"
                                               Visibility="{Binding HasTags, Converter={StaticResource BoolToVis}}"
                                               Foreground="{DynamicResource UI4.Brush.Accent}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ui:UI4ListView.ItemTemplate>
                </ui:UI4ListView>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="还没有备忘" FontSize="16" HorizontalAlignment="Center"
                               Foreground="{DynamicResource UI4.Brush.TextMuted}"/>
                    <TextBlock Margin="0,8,0,0" FontSize="13" TextWrapping="Wrap" MaxWidth="260"
                               TextAlignment="Center" HorizontalAlignment="Center"
                               Text="按 Ctrl+N，或点上面的「＋ 新建备忘」开始记录。"
                               Foreground="{DynamicResource UI4.Brush.Placeholder}"/>
                </StackPanel>

                <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24"
                           TextWrapping="Wrap" MaxWidth="280" TextAlignment="Center"
                           Visibility="{Binding NoMatch, Converter={StaticResource BoolToVis}}"
                           Text="没有匹配的备忘。换个关键词，或把标签筛选清掉。"
                           Foreground="{DynamicResource UI4.Brush.TextMuted}"/>
            </Grid>

            <!-- 编辑档 -->
            <ui:UI4Panel Grid.Column="2" CornerRadius="12" ContentPadding="0"
                         ShadowDepth="8" ShadowBlurRadius="15" ShadowOpacity="0.1"
                         HoverScale="1"
                         Visibility="{Binding ShowDetail, Converter={StaticResource BoolToVis}}">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:UI4TextBox x:Name="TitleBox" Grid.Column="0" Height="40"
                                       FontSize="18" FontWeight="SemiBold" InnerPadding="12"
                                       PlaceholderText="备忘标题"
                                       IsEnabled="{Binding HasSelection}"
                                       Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}"/>
                        <ui:UI4Button Grid.Column="1" Content="返回列表" Width="88" Height="36"
                                      Margin="12,0,0,0"
                                      Visibility="{Binding ShowBackButton, Converter={StaticResource BoolToVis}}"
                                      Command="{Binding CloseDetailCommand}"/>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:UI4TextBox Grid.Column="0" Height="36" InnerPadding="12"
                                       PlaceholderText="标签，用逗号分隔，如：工作, 灵感"
                                       IsEnabled="{Binding HasSelection}"
                                       Text="{Binding EditTags, UpdateSourceTrigger=PropertyChanged}"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0"
                                    VerticalAlignment="Center">
                            <TextBlock Text="置顶" FontSize="13" VerticalAlignment="Center"
                                       Margin="0,0,8,0"
                                       Foreground="{DynamicResource UI4.Brush.TextMuted}"/>
                            <ui:UI4Switch IsOn="{Binding EditPinned, Mode=TwoWay}"
                                          SwitchWidth="44" SwitchHeight="24"
                                          IsEnabled="{Binding HasSelection}"/>
                        </StackPanel>
                    </Grid>

                    <ui:UI4TextBox x:Name="BodyBox" Grid.Row="2" Margin="0,12,0,0"
                                   MinHeight="120" AcceptsReturn="True" TextWrapping="Wrap"
                                   VerticalContentAlignment="Top"
                                   VerticalScrollBarVisibility="Auto" InnerPadding="12"
                                   IsEnabled="{Binding HasSelection}"
                                   Text="{Binding EditBody, UpdateSourceTrigger=PropertyChanged}"/>

                    <Grid Grid.Row="3" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CharCount, StringFormat={}{0} 字}" FontSize="12"
                                       Margin="0,0,12,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource UI4.Brush.TextMuted}"/>
                            <TextBlock Text="{Binding LineCount, StringFormat={}{0} 行}" FontSize="12"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource UI4.Brush.TextMuted}"/>
                            <TextBlock Margin="12,0,0,0" FontSize="12" VerticalAlignment="Center"
                                       Text="选中一条备忘后这里才可编辑"
                                       Visibility="{Binding HasSelection, Converter={StaticResource InvBoolToVis}}"
                                       Foreground="{DynamicResource UI4.Brush.Placeholder}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <ui:UI4Button Content="复制正文" Width="88" Height="32" Margin="0,0,8,0"
                                          FontSize="13" CornerRadius="6"
                                          Command="{Binding CopyBodyCommand}"/>
                            <ui:UI4Button Content="保存" Width="72" Height="32" Margin="0,0,8,0"
                                          FontSize="13" CornerRadius="6"
                                          Command="{Binding SaveNowCommand}"/>
                            <ui:UI4Button Content="删除" Width="72" Height="32"
                                          FontSize="13" CornerRadius="6"
                                          GradientStart="{x:Static h:Theme.Danger}"
                                          GradientEnd="{x:Static h:Theme.Danger}"
                                          Command="{Binding DeleteNoteCommand}"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </ui:UI4Panel>
        </Grid>
    </Grid>
</UserControl>
