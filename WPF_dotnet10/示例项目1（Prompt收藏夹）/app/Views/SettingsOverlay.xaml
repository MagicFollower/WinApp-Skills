<UserControl x:Class="PromptFavorites.Views.SettingsOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:StartUI4Controls;assembly=StartUI4Controls"
             xmlns:h="clr-namespace:PromptFavorites.Helpers">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <!-- 标题 -->
            <TextBlock Text="设置" FontSize="{DynamicResource App.Font.Size.Icon}" FontWeight="SemiBold"
                       Foreground="{DynamicResource UI4.Brush.Text}"
                       Margin="0,0,0,16"/>

            <!-- ① 应用信息（只读） -->
            <TextBlock Text="应用信息" FontSize="{DynamicResource App.Font.Size.Medium}" FontWeight="SemiBold"
                       Foreground="{DynamicResource UI4.Brush.Icon}"
                       Margin="0,0,0,8"/>
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="92"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="应用版本"
                           Foreground="{DynamicResource UI4.Brush.Icon}"
                           FontSize="{DynamicResource App.Font.Size.Small}" Margin="0,4"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding AppVersion}"
                           Foreground="{DynamicResource UI4.Brush.Text}"
                           FontSize="{DynamicResource App.Font.Size.Small}" Margin="0,4"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="运行时"
                           Foreground="{DynamicResource UI4.Brush.Icon}"
                           FontSize="{DynamicResource App.Font.Size.Small}" Margin="0,4"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding RuntimeVersion}"
                           Foreground="{DynamicResource UI4.Brush.Text}"
                           FontSize="{DynamicResource App.Font.Size.Small}" Margin="0,4"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="组件库"
                           Foreground="{DynamicResource UI4.Brush.Icon}"
                           FontSize="{DynamicResource App.Font.Size.Small}" Margin="0,4"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LibraryVersion}"
                           Foreground="{DynamicResource UI4.Brush.Text}"
                           FontSize="{DynamicResource App.Font.Size.Small}" Margin="0,4"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="数据根目录"
                           Foreground="{DynamicResource UI4.Brush.Icon}"
                           FontSize="{DynamicResource App.Font.Size.Small}" Margin="0,4"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DataRootPath}"
                           Foreground="{DynamicResource UI4.Brush.Text}"
                           FontSize="{DynamicResource App.Font.Size.Small}" Margin="0,4"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding DataRootPath}"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="设置目录"
                           Foreground="{DynamicResource UI4.Brush.Icon}"
                           FontSize="{DynamicResource App.Font.Size.Small}" Margin="0,4"/>
                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SettingsFolder}"
                           Foreground="{DynamicResource UI4.Brush.Text}"
                           FontSize="{DynamicResource App.Font.Size.Small}" Margin="0,4"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding SettingsFolder}"/>
            </Grid>

            <Border Height="1" Background="{DynamicResource UI4.Brush.BorderNormal}" Margin="0,0,0,16"/>

            <!-- ② 配色档：按钮文案是目标档，当前档由设置单源决定 -->
            <TextBlock Text="配色" FontSize="{DynamicResource App.Font.Size.Medium}" FontWeight="SemiBold"
                       Foreground="{DynamicResource UI4.Brush.Icon}"
                       Margin="0,0,0,8"/>
            <ui:UI4Button Content="{Binding ThemeModeSwitchLabel}" Height="32" Padding="16,0"
                          CornerRadius="8"
                          FontSize="{DynamicResource UI4.Font.Size.Base}"
                          GradientStart="{DynamicResource UI4.Color.OffBackground}"
                          GradientEnd="{DynamicResource UI4.Color.OffBackground}"
                          HoverBackground="{DynamicResource UI4.Brush.AccentDark}"
                          Click="ToggleTheme_Click"
                          HorizontalAlignment="Left" Margin="0,0,0,16"/>

            <Border Height="1" Background="{DynamicResource UI4.Brush.BorderNormal}" Margin="0,0,0,16"/>

            <!-- ③ 字体 -->
            <TextBlock Text="字体" FontSize="{DynamicResource App.Font.Size.Medium}" FontWeight="SemiBold"
                       Foreground="{DynamicResource UI4.Brush.Icon}"
                       Margin="0,0,0,8"/>

            <TextBlock Text="字体族" Foreground="{DynamicResource UI4.Brush.Icon}"
                       FontSize="{DynamicResource App.Font.Size.Small}" Margin="0,0,0,4"/>
            <ui:UI4ComboBox Height="32"
                            ItemsSource="{Binding AvailableFonts}"
                            SelectedItem="{Binding SelectedFontFamily}"
                            Margin="0,0,0,8">
                <ui:UI4ComboBox.ItemTemplate>
                    <DataTemplate>
                        <!-- 列表项是字体族名字符串；用该字体本身渲染，选中项与列表口径一致 -->
                        <TextBlock Text="{Binding}" FontFamily="{Binding}"/>
                    </DataTemplate>
                </ui:UI4ComboBox.ItemTemplate>
            </ui:UI4ComboBox>

            <TextBlock Foreground="{DynamicResource UI4.Brush.Icon}"
                       FontSize="{DynamicResource App.Font.Size.Small}" Margin="0,0,0,4">
                <TextBlock.Text>
                    <Binding Path="BaseFontSize" StringFormat="正文字号：{0:F0}"/>
                </TextBlock.Text>
            </TextBlock>
            <ui:UI4Slider Minimum="{x:Static h:Typography.MinBaseSize}"
                          Maximum="{x:Static h:Typography.MaxBaseSize}"
                          IsValueVisible="True"
                          Value="{Binding BaseFontSize}"
                          Margin="0,0,0,8"/>

            <TextBlock Text="字号调的是正文基准，标题/标签/图标按固定层级跟随。"
                       Foreground="{DynamicResource UI4.Brush.TextMuted}"
                       FontSize="{DynamicResource App.Font.Size.Caption}"
                       TextWrapping="Wrap" Margin="0,0,0,12"/>

            <ui:UI4Button Content="恢复默认字体与字号" Height="{DynamicResource App.Size.RoundButton}" Padding="12,0"
                          CornerRadius="{DynamicResource App.Radius.RoundButton}"
                          FontSize="{DynamicResource App.Font.Size.Small}"
                          GradientStart="{DynamicResource UI4.Color.OffBackground}"
                          GradientEnd="{DynamicResource UI4.Color.OffBackground}"
                          HoverBackground="{DynamicResource UI4.Brush.AccentDark}"
                          Click="ResetTypography_Click"
                          HorizontalAlignment="Left" Margin="0,0,0,16"/>

            <Border Height="1" Background="{DynamicResource UI4.Brush.BorderNormal}" Margin="0,0,0,16"/>

            <!-- ④ 全局缩放 -->
            <TextBlock Text="全局缩放" FontSize="{DynamicResource App.Font.Size.Medium}" FontWeight="SemiBold"
                       Foreground="{DynamicResource UI4.Brush.Icon}"
                       Margin="0,0,0,8"/>

            <TextBlock Foreground="{DynamicResource UI4.Brush.Icon}"
                       FontSize="{DynamicResource App.Font.Size.Small}" Margin="0,0,0,4">
                <TextBlock.Text>
                    <Binding Path="ZoomPercent" StringFormat="缩放：{0:F0}%"/>
                </TextBlock.Text>
            </TextBlock>
            <ui:UI4Slider Minimum="{x:Static h:Typography.MinZoomPercent}"
                          Maximum="{x:Static h:Typography.MaxZoomPercent}"
                          TickFrequency="10" IsValueVisible="True"
                          Value="{Binding ZoomPercent}"
                          Margin="0,0,0,8"/>

            <ui:UI4Button Content="恢复默认 (100%)" Height="{DynamicResource App.Size.RoundButton}" Padding="12,0"
                          CornerRadius="{DynamicResource App.Radius.RoundButton}"
                          FontSize="{DynamicResource App.Font.Size.Small}"
                          GradientStart="{DynamicResource UI4.Color.OffBackground}"
                          GradientEnd="{DynamicResource UI4.Color.OffBackground}"
                          HoverBackground="{DynamicResource UI4.Brush.AccentDark}"
                          Click="ResetZoom_Click"
                          HorizontalAlignment="Left" Margin="0,0,0,16"/>

            <ui:UI4Button Content="完成" Height="34" Padding="24,0"
                          CornerRadius="8"
                          FontSize="{DynamicResource UI4.Font.Size.Base}"
                          GradientStart="{DynamicResource UI4.Color.Accent}"
                          GradientEnd="{DynamicResource UI4.Color.Accent}"
                          HoverBackground="{DynamicResource UI4.Brush.AccentDark}"
                          Click="Done_Click"
                          HorizontalAlignment="Right"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
