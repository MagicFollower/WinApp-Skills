<UserControl x:Class="PromptFavorites.Views.EntryListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:StartUI4Controls;assembly=StartUI4Controls"
             xmlns:h="clr-namespace:PromptFavorites.Helpers"
             Background="{DynamicResource UI4.Brush.Surface}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 控制条：收藏筛选 + 排序 -->
        <Border Grid.Row="0" Padding="8,8,8,4">
            <StackPanel>
                <DockPanel Margin="0,0,0,4">
                    <ui:UI4Button DockPanel.Dock="Right"
                                  Content="+" Width="28" Height="28"
                                  Margin="4,0,0,0"
                                  CornerRadius="14"
                                  FontSize="16" FontWeight="Bold"
                                  GradientStart="{x:Static h:Theme.Accent}"
                                  GradientEnd="{x:Static h:Theme.Accent}"
                                  HoverBackground="{DynamicResource App.Brush.AccentHover}"
                                  Command="{Binding AddEntryCommand}"
                                  ToolTip="新建条目"/>
                    <ui:UI4Button x:Name="FavoriteBtn"
                                  Content="★ 收藏"
                                  Height="28" Padding="10,0"
                                  CornerRadius="14"
                                  FontSize="12"
                                  HoverBackground="{DynamicResource App.Brush.AccentHover}"
                                  Click="FavoriteFilter_Click"/>
                </DockPanel>
                <WrapPanel>
                    <ui:UI4Button Content="使用次数" Height="24" Padding="8,0"
                                  CornerRadius="12" FontSize="11" Margin="0,4,4,0"
                                  HoverBackground="{DynamicResource App.Brush.AccentHover}"
                                  Click="SortUseCount_Click" x:Name="SortUseCountBtn"/>
                    <ui:UI4Button Content="修改时间" Height="24" Padding="8,0"
                                  CornerRadius="12" FontSize="11" Margin="0,4,4,0"
                                  HoverBackground="{DynamicResource App.Brush.AccentHover}"
                                  Click="SortUpdatedAt_Click" x:Name="SortUpdatedAtBtn"/>
                    <ui:UI4Button Content="创建时间" Height="24" Padding="8,0"
                                  CornerRadius="12" FontSize="11" Margin="0,4,4,0"
                                  HoverBackground="{DynamicResource App.Brush.AccentHover}"
                                  Click="SortCreatedAt_Click" x:Name="SortCreatedAtBtn"/>
                    <ui:UI4Button Content="名称" Height="24" Padding="8,0"
                                  CornerRadius="12" FontSize="11" Margin="0,4,4,0"
                                  HoverBackground="{DynamicResource App.Brush.AccentHover}"
                                  Click="SortName_Click" x:Name="SortNameBtn"/>
                    <ui:UI4Button Content="自定义" Height="24" Padding="8,0"
                                  CornerRadius="12" FontSize="11" Margin="0,4,4,0"
                                  HoverBackground="{DynamicResource App.Brush.AccentHover}"
                                  Click="SortCustom_Click" x:Name="SortCustomBtn"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <Separator Grid.Row="1"/>

        <!-- 条目列表 -->
        <ui:UI4ListBox x:Name="EntryList"
                       Grid.Row="2"
                       Margin="8,4,8,0"
                       ListStyleType="None"
                       PressedBackground="{DynamicResource UI4.Color.RowSelectedBackground}"
                       PressedForeground="{DynamicResource UI4.Color.TextForeground}"
                       ItemsSource="{Binding Entries}"
                       SelectedItem="{Binding SelectedEntry}"
                       h:ReorderBehavior.Enabled="{Binding CanReorder}"
                       h:ReorderBehavior.CommitCommand="{Binding ReorderCommand}">
            <ui:UI4ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="4,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}"
                                       Foreground="{DynamicResource UI4.Brush.Text}"
                                       FontWeight="SemiBold" FontSize="13"
                                       TextTrimming="CharacterEllipsis"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Foreground="{DynamicResource UI4.Brush.Icon}" FontSize="11">
                                    <TextBlock.Text>
                                        <Binding Path="UseCount"
                                                 Converter="{StaticResource UseCountDisplay}"/>
                                    </TextBlock.Text>
                                </TextBlock>
                                <Button Content="{Binding Favorite, Converter={StaticResource BoolToStar}}"
                                        Foreground="#FFFFB800" FontSize="12" Margin="8,0,0,0"
                                        Background="Transparent" BorderThickness="0"
                                        Padding="0" Cursor="Hand"
                                        ToolTip="收藏/取消收藏"
                                        Click="ToggleFavorite_Click"
                                        Tag="{Binding}"/>
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="&#x1F4CB;"
                                FontSize="14"
                                Background="Transparent" BorderThickness="0"
                                Cursor="Hand"
                                VerticalAlignment="Center"
                                ToolTip="复制"
                                Click="QuickCopy_Click"
                                Tag="{Binding}"/>
                    </Grid>
                </DataTemplate>
            </ui:UI4ListBox.ItemTemplate>
        </ui:UI4ListBox>
    </Grid>
</UserControl>
