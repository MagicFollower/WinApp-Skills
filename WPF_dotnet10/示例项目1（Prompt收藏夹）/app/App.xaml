<Application x:Class="PromptFavorites.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:StartUI4Controls;assembly=StartUI4Controls"
             xmlns:c="clr-namespace:PromptFavorites.Converters"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <c:BoolToStarConverter x:Key="BoolToStar"/>
        <c:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <c:InverseBoolConverter x:Key="InverseBool"/>
        <c:UseCountDisplayConverter x:Key="UseCountDisplay"/>
        <c:DateTimeFormatConverter x:Key="DateTimeFormat"/>
        <c:SortModeMatchConverter x:Key="SortModeMatch"/>

        <!-- 配色取自 Helpers/Theme.cs（终端靛浅色方案）；FavoriteHover 是"收藏"语义色的 hover，不随界面配色走 -->
        <SolidColorBrush x:Key="App.Brush.Accent" Color="#4F6BE8"/>
        <SolidColorBrush x:Key="App.Brush.AccentHover" Color="#435AC5"/>
        <SolidColorBrush x:Key="App.Brush.Neutral" Color="#D3DBE6"/>
        <SolidColorBrush x:Key="App.Brush.NeutralHover" Color="#EFF2FE"/>
        <SolidColorBrush x:Key="App.Brush.FavoriteHover" Color="#E08A00"/>
    </Application.Resources>
</Application>
