<Application x:Class="PromptFavorites.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
             xmlns:h="clr-namespace:PromptFavorites.Helpers"
             xmlns:c="clr-namespace:PromptFavorites.Converters"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <c:BoolToStarConverter x:Key="BoolToStar"/>
        <c:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <c:UseCountDisplayConverter x:Key="UseCountDisplay"/>
        <c:DateTimeFormatConverter x:Key="DateTimeFormat"/>
        <c:ZoomedSizeConverter x:Key="ZoomedSize"/>

        <!-- 语义色：收藏星标。按设计它不跟界面配色走，明暗两档同一个金；
             值取自 Helpers/Theme.cs，不在这里重抄一遍十六进制。
             App.Brush.Toast / ToastText 由 HostPalette.Apply 按当前档派生后写进同一个资源根。 -->
        <x:Static x:Key="App.Color.Favorite" Member="h:Theme.Favorite"/>
        <x:Static x:Key="App.Color.FavoriteEnd" Member="h:Theme.FavoriteEnd"/>
        <SolidColorBrush x:Key="App.Brush.Favorite" po:Freeze="True"
                         Color="{StaticResource App.Color.Favorite}"/>
        <SolidColorBrush x:Key="App.Brush.FavoriteHover" po:Freeze="True"
                         Color="{x:Static h:Theme.FavoriteHover}"/>
    </Application.Resources>
</Application>
