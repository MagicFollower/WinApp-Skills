<Application x:Class="QuickPanel.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:StartUI4Controls;assembly=StartUI4Controls"
             xmlns:c="clr-namespace:QuickPanel.Converters"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <!-- 注册了就要有引用点：这两个转换器分别服务设置浮层的显隐与缩放下的窗口下限。
             卡片与分组模板放在 MainWindow.xaml 的 Window.Resources 里——模板中要挂
             SelectionChanged 处理器，而处理器只能解析到"这段 XAML 的宿主类"，
             放在 App.xaml 里就只会解析到 App，接不上主窗口的执行通路。 -->
        <c:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <c:ZoomedSizeConverter x:Key="ZoomedSize"/>
    </Application.Resources>
</Application>
