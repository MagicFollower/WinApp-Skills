{
  "name": "linux-command-manual",
  "productName": "LinuxCmdManual",
  "version": "0.1.0",
  "private": true,
  "description": "Linux 命令手册桌面应用：底部 reactbits Dock 按主题分组，左侧命令列表，右侧 markdown 预览与编辑",
  "main": "dist-electron/main.js",
  "author": "local",
  "license": "UNLICENSED",
  "scripts": {
    "ensure-electron": "install-electron",
    "dev": "node bin/dev.mjs",
    "build": "node bin/build.mjs",
    "dist": "node bin/build.mjs && electron-builder --win",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p electron/tsconfig.json"
  },
  "dependencies": {
    "motion": "^13.5.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "44.5.1",
    "electron-builder": "^26.15.3",
    "typescript": "^5.9.0",
    "vite": "^8.3.2"
  }
}
